# webappmonitor server config.
# Copy this file to `.env` (gitignored) and fill in the values.

# WSL2 Postgres on the i7. Database is created by the setup script.
DATABASE_URL=postgresql://webappmonitor:webappmonitor@localhost:5432/webappmonitor

# Port this backend listens on. Allocated from PORTS.md.
PORT=8170

# Comma-separated list of origins allowed by CORS for /api/*.
# Include dev (Vite) AND prod (public domain).
CLIENT_ORIGIN_URL=http://localhost:3170,https://webapp-monitor.uskiano.com

# Email allowlist.
# Anyone signing in via Firebase whose email is NOT in this list is rejected
# server-side with 403, no DB row created. Comma-separated.
ALLOWED_EMAILS=uskajitas@gmail.com,usquiano@gmail.com

# Admin emails. These users are auto-given role='admin' on first login,
# regardless of what the DB says. Used as the bootstrap admin gate.
ADMIN_EMAILS=uskajitas@gmail.com
